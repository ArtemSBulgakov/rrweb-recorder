{
  "name": "rrweb-recorder-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "build": "npm run build:chromium && npm run build:firefox",
    "build:chromium": "npm run icons && vite build --mode chromium",
    "build:firefox": "npm run icons && vite build --mode firefox",
    "build:playwright": "vite build --mode playwright",
    "package": "npm run build && node scripts/package.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@rrweb/rrweb-plugin-console-record": "latest",
    "@rrweb/rrweb-plugin-network-record": "latest",
    "@rrweb/rrweb-plugin-sequential-id-record": "latest",
    "fflate": "^0.8.3",
    "rrweb": "latest",
    "rrweb-player": "latest",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.7",
    "@types/node": "^26.4.0",
    "@types/webextension-polyfill": "^0.12.5",
    "fake-indexeddb": "^6.2.5",
    "puppeteer-core": "^25.9.0",
    "sharp": "^0.35.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
